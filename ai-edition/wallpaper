#!/bin/sh
# KushOS wallpaper: wallpaper [list|name|next] — switch the desktop wallpaper.
# Wallpapers live in /usr/share/kushos/wallpapers/ (PNG in the ready image,
# SVG sources in the repo under ai-edition/desktop/wallpapers/).
# Usage: wallpaper list | wallpaper meroe-pyramids | wallpaper next
DIR=/usr/share/kushos/wallpapers
LINK=/usr/share/kushos/wallpaper.png
CURRENT=/usr/share/kushos/wallpaper-current

list() {
    for f in "$DIR"/*.png "$DIR"/*.jpg; do
        [ -e "$f" ] || continue
        basename "$f" | sed 's/\.[^.]*$//'
    done | sort -u
}

apply() {
    name="$1"
    file=""
    for ext in png jpg; do
        [ -f "$DIR/$name.$ext" ] && file="$DIR/$name.$ext" && break
    done
    [ -n "$file" ] || { echo "No wallpaper named '$name'" >&2; list; exit 1; }
    ln -sf "$file" "$LINK"
    echo "$name" > "$CURRENT"
    if pgrep swaybg >/dev/null 2>&1; then
        pkill swaybg
        (swaybg -i "$file" >/dev/null 2>&1 &)
    fi
    echo "Wallpaper: $name"
}

case "$1" in
    ""|list) list ;;
    next)
        names=$(list)
        [ -z "$names" ] && { echo "No wallpapers found in $DIR" >&2; exit 1; }
        cur=$(cat "$CURRENT" 2>/dev/null)
        nxt=$(printf '%s\n%s\n' "$names" "$names" | grep -A1 -x "$cur" | tail -1)
        [ -z "$nxt" ] && nxt=$(printf '%s\n' "$names" | head -1)
        apply "$nxt"
        ;;
    *) apply "$1" ;;
esac
